      "obligation_id": "obligation:pnp-migration-20260930-local",
      "kind": "lemma",
      "statement": {
        "text": "For every finite non-tautological CNF F and pivot x, retain clauses omitting x and resolve every x-clause against every not-x-clause, deleting tautological resolvents. For every assignment of other variables, the resulting CNF is true exactly when some extension to x satisfies F. This asserts correctness, not a polynomial size bound.",
        "language": "en",
        "formal_declaration": null
      },
      "statement_sha256": "53905d5ef88460a52e81918054c04ade3ae583cfd01df62fa52d1ba0eb80f2c5",
